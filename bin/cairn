#!/usr/bin/env bash
#
# cairn: incremental hard-link snapshot backups, written in Bash.
#
# Usage: cairn [OPTIONS] COMMAND [ARGS]
# Run `cairn --help` for the full text.

set -o errexit -o nounset -o pipefail
# 命令替换里的失败也要让 errexit 生效; errtrace 让 ERR trap 进入函数和子 shell。
shopt -s inherit_errexit
set -o errtrace

readonly CAIRN_VERSION='0.1.0'

# -c/--config 的值; 空表示未给出。
CAIRN_CONFIG_OPT=''

# -n/--dry-run 设为 1: 只报告, 不删除。
CAIRN_DRY_RUN=0

# 库目录: 环境变量优先, 否则相对于本脚本 (跟随符号链接) 的 ../lib/cairn。
cairn_script="$(readlink -f -- "${BASH_SOURCE[0]}")"
CAIRN_LIB="${CAIRN_LIB:-$(dirname -- "${cairn_script}")/../lib/cairn}"
readonly CAIRN_LIB

# shellcheck source=../lib/cairn/log.sh
source "${CAIRN_LIB}/log.sh"
# shellcheck source=../lib/cairn/config.sh
source "${CAIRN_LIB}/config.sh"
# shellcheck source=../lib/cairn/repo.sh
source "${CAIRN_LIB}/repo.sh"
# shellcheck source=../lib/cairn/snapshot.sh
source "${CAIRN_LIB}/snapshot.sh"
# shellcheck source=../lib/cairn/prune.sh
source "${CAIRN_LIB}/prune.sh"
# shellcheck source=../lib/cairn/manifest.sh
source "${CAIRN_LIB}/manifest.sh"
# shellcheck source=../lib/cairn/lock.sh
source "${CAIRN_LIB}/lock.sh"

#######################################
# Print the usage text.
# Outputs:
#   Writes the text to stdout.
#######################################
usage() {
  cat <<'USAGE'
Usage: cairn [OPTIONS] COMMAND [ARGS]

Options:
  -c, --config FILE  use FILE as the config file
  -n, --dry-run      show what snapshot or prune would do, change nothing
  -v, --verbose      also show what is kept and debug messages
  -q, --quiet        suppress informational messages
  -h, --help         show this help and exit
      --version      print the version and exit
  --                 end of options

Commands:
  help               same as --help
  init REPO          create the repository REPO and a config file
  snapshot           copy the configured sources into a new snapshot
  list               print each snapshot with file count and size, oldest first
  verify [NAME]      check a snapshot (default: latest) against its manifest
  diff OLD NEW       list files added (A), deleted (D) or modified (M)
  prune              remove snapshots the retention policy no longer keeps
  report             summarise logs/cairn.log: counts, bytes, per day

Exit codes:
  0    success
  1    runtime failure
  2    usage error
  3    config or repository error
  4    another cairn holds the repository lock
  130  interrupted (SIGINT)
  143  terminated (SIGTERM)

Config file: -c FILE, else $CAIRN_CONFIG, else
${XDG_CONFIG_HOME:-$HOME/.config}/cairn/cairn.conf
USAGE
}

#######################################
# Report a usage error.
# Arguments:
#   Message text.
# Returns:
#   2, always.
#######################################
usage_error() {
  cairn::log::err "$1"
  cairn::log::err "run 'cairn --help' for usage"
  return 2
}

#######################################
# The init command: create the repository and, if needed, the config.
# Arguments:
#   Repository directory.
# Outputs:
#   Writes the config file when it does not exist yet.
# Returns:
#   0 on success, 1 on failure, 3 on a repository error.
#######################################
cmd_init() {
  local dir
  dir="$(cairn::repo::init "$1")" || return
  if [[ -z "${dir}" ]]; then
    return 0
  fi
  local config
  config="$(cairn::config::path)" || return 1
  if [[ -e "${config}" ]]; then
    return 0
  fi
  mkdir -p -- "$(dirname -- "${config}")" || return 1
  cairn::config::template "${dir}" >"${config}" || return 1
  cairn::log::info "wrote ${config}"
}

#######################################
# The snapshot command.
# Arguments:
#   None; "REPO SOURCE..." (two or more) selects the chapter 2 form.
# Returns:
#   Status of the snapshot, 2 on a usage error, 3 on a config error.
#######################################
cmd_snapshot() {
  if (($# >= 2)); then
    cairn::snapshot::create_adhoc "$@"
    return
  fi
  if (($# == 1)); then
    usage_error 'snapshot takes no arguments' || return
  fi
  cairn::config::load "$(cairn::config::path)" || return
  cairn::snapshot::create
}

#######################################
# Load the config file and check the repository.
# Returns:
#   0 on success, 3 on a config or repository error.
#######################################
load_repo() {
  cairn::config::load "$(cairn::config::path)" || return
  cairn::repo::check "${CAIRN_REPO}"
}

#######################################
# The list command: print each snapshot with file count and size.
# Returns:
#   0 on success, 1 if sizes cannot be computed, 2 on a usage error,
#   3 on a config error.
#######################################
cmd_list() {
  if (($# != 0)); then
    usage_error 'list takes no arguments' || return
  fi
  load_repo || return
  local -a names sizes
  readarray -t names < <(cairn::repo::snapshots "${CAIRN_REPO}")
  readarray -t sizes < <(cairn::repo::sizes "${CAIRN_REPO}")
  if ((${#names[@]} != ${#sizes[@]})); then
    cairn::log::err 'cannot compute the snapshot sizes'
    return 1
  fi
  printf 'NAME               FILES     SIZE\n'
  local i count
  for ((i = 0; i < ${#names[@]}; i++)); do
    count="$(cairn::manifest::count "${CAIRN_REPO}" "${names[i]}")" \
      || count='-'
    printf '%-18s %8s %8s\n' "${names[i]}" "${count}" "${sizes[i]}"
  done
}

#######################################
# The verify command: check a snapshot against its manifest.
# Arguments:
#   Optional snapshot name, default the latest.
# Returns:
#   0 if the snapshot is intact, 1 if not, 2 on a usage error,
#   3 on a config error.
#######################################
cmd_verify() {
  if (($# > 1)); then
    usage_error 'usage: cairn verify [NAME]' || return
  fi
  load_repo || return
  local name
  if (($# == 1)); then
    name="$1"
  elif ! name="$(cairn::repo::latest "${CAIRN_REPO}")"; then
    cairn::log::err 'no snapshots to verify'
    return 1
  fi
  cairn::manifest::verify "${CAIRN_REPO}" "${name}"
}

#######################################
# The prune command: apply the retention policy.
# Returns:
#   0 on success, 1 on a deletion failure, 2 on a usage error,
#   3 on a config error.
#######################################
cmd_prune() {
  if (($# != 0)); then
    usage_error 'prune takes no arguments' || return
  fi
  load_repo || return
  cairn::prune::run
}

#######################################
# The diff command: compare the manifests of two snapshots.
# Arguments:
#   Old and new snapshot name.
# Returns:
#   0 on success (also when they differ), 1 on an unknown snapshot,
#   2 on a usage error, 3 on a config error.
#######################################
cmd_diff() {
  if (($# != 2)); then
    usage_error 'usage: cairn diff OLD NEW' || return
  fi
  load_repo || return
  cairn::manifest::diff "${CAIRN_REPO}" "$1" "$2"
}

#######################################
# The report command: summarise the repository log.
# Globals:
#   CAIRN_LIB, CAIRN_REPO
# Outputs:
#   Writes the report to stdout; a missing log reads as empty.
# Returns:
#   0 on success, 1 if awk fails, 2 on a usage error, 3 on a config
#   error.
#######################################
cmd_report() {
  if (($# != 0)); then
    usage_error 'report takes no arguments' || return
  fi
  load_repo || return
  local log="${CAIRN_REPO}/logs/cairn.log"
  if [[ ! -f "${log}" ]]; then
    log=/dev/null
  fi
  awk -f "${CAIRN_LIB}/report.awk" "${log}"
}

#######################################
# ERR trap handler: report a command that failed unexpectedly.
#
# Failing function calls and "return" are not reported: either a command
# inside the function failed (and the trap already ran there), or the
# function ended with a deliberate "return N", which main turns into the
# exit status. With -v one line per call frame follows, innermost first.
# Globals:
#   CAIRN_VERBOSE, FUNCNAME, BASH_SOURCE, BASH_LINENO
# Arguments:
#   Exit status of the failed command, the command text.
# Outputs:
#   Writes the message and the frames to stderr.
#######################################
on_err() {
  local status="$1"
  local command="$2"
  if [[ "${command%% *}" == return ]] \
    || declare -F -- "${command%% *}" >/dev/null; then
    return 0
  fi
  cairn::log::err "command failed (exit ${status}): ${command}"
  if [[ "${CAIRN_VERBOSE}" != 1 ]]; then
    return 0
  fi
  local i
  for ((i = 1; i < ${#FUNCNAME[@]}; i++)); do
    printf '  at %s (%s:%s)\n' \
      "${FUNCNAME[i]}" "${BASH_SOURCE[i]}" "${BASH_LINENO[i - 1]}" >&2
  done
}

#######################################
# Entry point.
# Globals:
#   CAIRN_VERSION, CAIRN_CONFIG_OPT, CAIRN_DRY_RUN, CAIRN_VERBOSE,
#   CAIRN_QUIET
# Arguments:
#   Command line arguments.
# Returns:
#   0 on success, 2 on usage errors, 3 on config errors.
#######################################
main() {
  if (($# == 0)); then
    usage >&2
    return 2
  fi
  while (($# > 0)); do
    case "$1" in
      -h | --help)
        usage
        return 0
        ;;
      --version)
        printf 'cairn %s\n' "${CAIRN_VERSION}"
        return 0
        ;;
      -n | --dry-run)
        CAIRN_DRY_RUN=1
        shift
        ;;
      -v | --verbose)
        CAIRN_VERBOSE=1
        shift
        ;;
      -q | --quiet)
        CAIRN_QUIET=1
        shift
        ;;
      -c | --config)
        if (($# < 2)); then
          usage_error "option '$1' requires an argument" || return
        fi
        CAIRN_CONFIG_OPT="$2"
        shift 2
        ;;
      --config=*)
        CAIRN_CONFIG_OPT="${1#--config=}"
        shift
        ;;
      --)
        shift
        break
        ;;
      -*)
        usage_error "unknown option '$1'" || return
        ;;
      *) break ;;
    esac
  done
  if (($# == 0)); then
    usage >&2
    return 2
  fi
  local command="$1"
  shift
  case "${command}" in
    help) usage ;;
    init)
      if (($# != 1)); then
        usage_error 'usage: cairn init REPO' || return
      fi
      cmd_init "$1"
      ;;
    snapshot) cmd_snapshot "$@" ;;
    list) cmd_list "$@" ;;
    verify) cmd_verify "$@" ;;
    diff) cmd_diff "$@" ;;
    prune) cmd_prune "$@" ;;
    report) cmd_report "$@" ;;
    *) usage_error "unknown command '${command}'" || return ;;
  esac
}

trap 'on_err "$?" "${BASH_COMMAND}"' ERR
main "$@"
